{
  "components": {
    "schemas": {
      "ApiErrorMessage": {
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "CardV1View": {
        "properties": {
          "cardType": {
            "description": "Card Type. \n\nPossible values are: \n\n0 - Unknown / None. Default. \n\n1 - Passive card, with no electronic \n\n2 - Smartcard without European common data zone \n\n3 - Smartcard with European common data zone \n\n4 - Smartcard on which application may be installed by service providers",
            "example": 0,
            "format": "int32",
            "type": "integer"
          },
          "cardUid": {
            "description": "Card alternative Id",
            "type": "string"
          },
          "europeanStudentCardNumber": {
            "description": "The card number using the algorithm RFC-4122 version 1, use /api/v2/cards/generate-escn to generate a valid card number",
            "example": "3e506370-826a-103d-bf76-001000000001",
            "type": "string"
          },
          "student": {
            "$ref": "#/components/schemas/StudentView"
          }
        },
        "required": [
          "europeanStudentCardNumber"
        ],
        "type": "object"
      },
      "StudentPostView": {
        "properties": {
          "academicLevel": {
            "description": "Current academic level of the student. \n\nPossibles values are: \n\n6 - bachelor\u2019s degree \n\n7 - master\u2019s degree \n\n8 - doctorate",
            "example": 6,
            "format": "int32",
            "type": "integer"
          },
          "emailAddress": {
            "description": "The email of the student",
            "example": "student@example.com",
            "type": "string"
          },
          "europeanStudentIdentifier": {
            "description": "The european student identifier of the student",
            "example": "urn:schac:personalUniqueCode:int:esi:HR:xxxxxxxxxx",
            "type": "string"
          },
          "expiryDate": {
            "description": "The expiry date of the student's related cards (yyyy-MM-dd)",
            "format": "date",
            "type": "string"
          },
          "name": {
            "description": "The full name of the student",
            "example": "John Smith",
            "type": "string"
          },
          "phoneNumber": {
            "description": "The phone number of the student",
            "example": "6XXXXXXXX",
            "type": "string"
          },
          "picInstitutionCode": {
            "description": "The identifier of the organisation (PIC)",
            "example": 123456789,
            "type": "string"
          }
        },
        "required": [
          "emailAddress",
          "europeanStudentIdentifier",
          "expiryDate",
          "picInstitutionCode"
        ],
        "type": "object"
      },
      "StudentView": {
        "properties": {
          "academicLevel": {
            "description": "Current academic level of the student. \n\nPossibles values are: \n\n6 - bachelor\u2019s degree \n\n7 - master\u2019s degree \n\n8 - doctorate",
            "example": 6,
            "format": "int32",
            "type": "integer"
          },
          "cards": {
            "items": {
              "$ref": "#/components/schemas/CardV1View"
            },
            "type": "array"
          },
          "emailAddress": {
            "description": "The email of the student",
            "example": "john@email.edu",
            "type": "string"
          },
          "europeanStudentIdentifier": {
            "description": "The european student identifier of the student",
            "example": "urn:schac:personalUniqueCode:int:esi:HR:xxxxxxxxxx",
            "type": "string"
          },
          "expiryDate": {
            "description": "The expiry date of the student's related cards (yyyy-MM-dd:HH:mm:ss)",
            "format": "date-time",
            "type": "string"
          },
          "name": {
            "description": "The full name of the student",
            "example": "John Smith",
            "type": "string"
          },
          "phoneNumber": {
            "description": "The phone number of the student",
            "example": "6XXXXXXXX",
            "type": "string"
          },
          "picInstitutionCode": {
            "description": "The identifier of the organisation (PIC)",
            "example": 123456789,
            "type": "string"
          }
        },
        "required": [
          "europeanStudentIdentifier",
          "expiryDate",
          "picInstitutionCode"
        ],
        "type": "object"
      }
